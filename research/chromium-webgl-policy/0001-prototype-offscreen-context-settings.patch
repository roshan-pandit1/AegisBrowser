diff --git a/third_party/blink/web_tests/fast/canvas/aegis-offscreen-webgl-settings.html b/third_party/blink/web_tests/fast/canvas/aegis-offscreen-webgl-settings.html
new file mode 100644
index 0000000..cf12fe4
--- /dev/null
+++ b/third_party/blink/web_tests/fast/canvas/aegis-offscreen-webgl-settings.html
@@ -0,0 +1,105 @@
+<!doctype html>
+<meta charset="utf-8">
+<title>Research: OffscreenCanvas WebGL per-context settings</title>
+<script src="/resources/testharness.js"></script>
+<script src="/resources/testharnessreport.js"></script>
+<script>
+'use strict';
+
+// These tests require a content_shell with working WebGL1 and WebGL2 positive
+// controls. Missing GPU support must fail rather than stand in for protection.
+test(() => assert_false(internals.runtimeFlags.aegisOffscreenWebGLSettingsEnabled),
+     'research feature is off by default');
+add_completion_callback(() => { internals.runtimeFlags.aegisOffscreenWebGLSettingsEnabled = false; });
+
+const workerSource = `
+  onmessage = async ({data}) => {
+    if (data.nested) {
+      const nested = new Worker(self.location.href);
+      nested.onmessage = e => { postMessage(e.data); nested.terminate(); };
+      nested.onerror = () => { postMessage({error: 'nested worker failed'}); nested.terminate(); };
+      nested.postMessage({version: data.version});
+      return;
+    }
+    const canvas = data.canvas || new OffscreenCanvas(1, 1);
+    const gl = canvas.getContext(data.version);
+    let rendered = false;
+    if (gl) {
+      gl.clearColor(0, 0, 0, 1);
+      gl.clear(gl.COLOR_BUFFER_BIT);
+      const pixel = new Uint8Array(4);
+      gl.readPixels(0, 0, 1, 1, gl.RGBA, gl.UNSIGNED_BYTE, pixel);
+      rendered = gl.getError() === gl.NO_ERROR;
+      gl.getExtension('WEBGL_lose_context')?.loseContext();
+    }
+    postMessage({available: !!gl, rendered});
+  };
+`;
+const workerUrl = URL.createObjectURL(new Blob([workerSource], {type:'text/javascript'}));
+add_completion_callback(() => URL.revokeObjectURL(workerUrl));
+
+function workerResult(version, nested = false, canvas = null) {
+  return new Promise((resolve, reject) => {
+    const worker = new Worker(workerUrl);
+    const timer = setTimeout(() => { worker.terminate(); reject(new Error('worker timeout')); }, 10000);
+    worker.onmessage = e => {
+      clearTimeout(timer);
+      worker.terminate();
+      if (e.data.error) reject(new Error(e.data.error));
+      else resolve(e.data);
+    };
+    worker.onerror = () => { clearTimeout(timer); worker.terminate(); reject(new Error('worker error')); };
+    worker.postMessage({version, nested, canvas}, canvas ? [canvas] : []);
+  });
+}
+
+function setWebGL(enabled) {
+  internals.settings.setWebGL1Enabled(enabled);
+  internals.settings.setWebGL2Enabled(enabled);
+}
+
+promise_test(async t => {
+  t.add_cleanup(() => setWebGL(true));
+  setWebGL(false);
+  const doc = new OffscreenCanvas(1,1).getContext('webgl');
+  assert_not_equals(doc, null, 'guard-off document retains stock behavior');
+  doc.getExtension('WEBGL_lose_context')?.loseContext();
+  const worker = await workerResult('webgl');
+  assert_true(worker.available && worker.rendered, 'guard-off worker retains stock behavior');
+}, 'default-off research feature preserves stock OffscreenCanvas behavior');
+
+for (const version of ['webgl', 'webgl2']) {
+  promise_test(async t => {
+    internals.runtimeFlags.aegisOffscreenWebGLSettingsEnabled = true;
+    setWebGL(true);
+    const doc = new OffscreenCanvas(1,1).getContext(version);
+    assert_not_equals(doc, null, version + ' document positive control');
+    doc.clear(doc.COLOR_BUFFER_BIT);
+    assert_equals(doc.getError(), doc.NO_ERROR);
+    doc.getExtension('WEBGL_lose_context')?.loseContext();
+    const worker = await workerResult(version);
+    assert_true(worker.available, version + ' dedicated-worker positive control');
+    assert_true(worker.rendered, version + ' dedicated-worker readback control');
+    const nested = await workerResult(version, true);
+    assert_true(nested.available && nested.rendered, version + ' nested-worker positive control');
+    const transferred = await workerResult(version, false, new OffscreenCanvas(1,1));
+    assert_true(transferred.available && transferred.rendered, version + ' transferred-canvas positive control');
+  }, version + ' enabled settings preserve document and worker positive controls');
+
+  promise_test(async t => {
+    t.add_cleanup(() => setWebGL(true));
+    setWebGL(false);
+    assert_equals(new OffscreenCanvas(1,1).getContext(version), null, 'document OffscreenCanvas blocked');
+    const dedicated = await workerResult(version);
+    assert_false(dedicated.available, 'dedicated-worker OffscreenCanvas blocked');
+    const nested = await workerResult(version, true);
+    assert_false(nested.available, 'nested dedicated worker inherits the snapshot');
+    const transferred = await workerResult(version, false, new OffscreenCanvas(1,1));
+    assert_false(transferred.available, 'same-policy transfer evaluated at receiver');
+    const twoD = new OffscreenCanvas(1,1).getContext('2d');
+    assert_not_equals(twoD, null, 'Canvas 2D remains available');
+    twoD.fillRect(0,0,1,1);
+    assert_equals(twoD.getImageData(0,0,1,1).data.length, 4);
+  }, version + ' disabled settings block document and dedicated-worker contexts');
+}
+</script>
