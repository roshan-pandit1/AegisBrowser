+// Research prototype: the enabled feature applies the receiving document's
+// settings or a dedicated worker's startup snapshot. Other worker types and
+// transfer policy semantics are deliberately not qualified by this patch.
+bool OffscreenCanvas::IsWebGL1Enabled() const {
+  if (!RuntimeEnabledFeatures::AegisOffscreenWebGLSettingsEnabled())
+    return true;
+  if (auto* window = DynamicTo<LocalDOMWindow>(GetExecutionContext())) {
+    auto* frame = window->GetFrame();
+    auto* settings = frame ? frame->GetSettings() : nullptr;
+    return settings && settings->GetWebGL1Enabled();
+  }
+  if (auto* worker =
+          DynamicTo<DedicatedWorkerGlobalScope>(GetExecutionContext())) {
+    auto* settings = worker->GetWorkerSettings();
+    return settings && settings->GetWebGL1Enabled();
+  }
+  return true;
+}
+
+bool OffscreenCanvas::IsWebGL2Enabled() const {
+  if (!RuntimeEnabledFeatures::AegisOffscreenWebGLSettingsEnabled())
+    return true;
+  if (auto* window = DynamicTo<LocalDOMWindow>(GetExecutionContext())) {
+    auto* frame = window->GetFrame();
+    auto* settings = frame ? frame->GetSettings() : nullptr;
+    return settings && settings->GetWebGL2Enabled();
+  }
+  if (auto* worker =
+          DynamicTo<DedicatedWorkerGlobalScope>(GetExecutionContext())) {
+    auto* settings = worker->GetWorkerSettings();
+    return settings && settings->GetWebGL2Enabled();
+  }
+  return true;
+}
