<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants Condition="'$(CompatGeneration)' == 'old'">$(DefineConstants);COMPAT_OLD</DefineConstants>
    <DefineConstants Condition="'$(CompatGeneration)' == 'new'">$(DefineConstants);COMPAT_NEW</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../../../AegisBrowser.Core/*.cs" />
    <EmbeddedResource Include="../../../AegisBrowser.Core/public_suffix_list.dat" LogicalName="AegisBrowser.Core.public_suffix_list.dat" />
  </ItemGroup>
  <ItemGroup Condition="'$(CompatGeneration)' == 'old'">
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.33" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(CompatGeneration)' == 'new'">
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.15" />
  </ItemGroup>
  <Target Name="RequireCompatibilityGeneration" BeforeTargets="CollectPackageReferences">
    <Error Condition="'$(CompatGeneration)' != 'old' and '$(CompatGeneration)' != 'new'" Text="Select old or new compatibility fixture packages." />
  </Target>
</Project>
