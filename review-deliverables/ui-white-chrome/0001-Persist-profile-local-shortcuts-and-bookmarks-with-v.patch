Subject: [PATCH 1/2] Persist profile-local shortcuts and bookmarks with
 validation

---
 AegisBrowser.Core/SiteLibraryStore.cs  | 52 ++++++++++++++++++++++++++
 AegisBrowser.Tests/Program.cs          |  1 +
 AegisBrowser.Tests/SiteLibraryTests.cs | 33 ++++++++++++++++
 3 files changed, 86 insertions(+)
 create mode 100644 AegisBrowser.Core/SiteLibraryStore.cs
 create mode 100644 AegisBrowser.Tests/SiteLibraryTests.cs

diff --git a/AegisBrowser.Core/SiteLibraryStore.cs b/AegisBrowser.Core/SiteLibraryStore.cs
new file mode 100644
index 0000000..14fbeb1
--- /dev/null
+++ b/AegisBrowser.Core/SiteLibraryStore.cs
@@ -0,0 +1,52 @@
+using System.Text.Json;
+
+namespace AegisBrowser.Core;
+
+public sealed record SavedSite(string Title, string Url);
+public sealed record SiteLibrary(SavedSite[] Shortcuts, SavedSite[] Bookmarks)
+{
+    public static SiteLibrary Empty => new([], []);
+}
+
+// Explicitly saved sites only. No browsing history or remote favicon requests.
+public sealed class SiteLibraryStore(string profileDirectory)
+{
+    private readonly string path = Path.Combine(profileDirectory, "sites.json");
+    private bool loadFailed;
+    public SiteLibrary Load()
+    {
+        try {
+            if (!File.Exists(path)) return SiteLibrary.Empty;
+            if (new FileInfo(path).Length > 262144) throw new IOException("Saved sites file is too large.");
+            var value = JsonSerializer.Deserialize<SiteLibrary>(File.ReadAllText(path)) ?? throw new ArgumentException();
+            Validate(value); return value;
+        }
+        catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or JsonException or ArgumentException) {
+            loadFailed = true;
+            throw new IOException("Could not load sites.json. Repair or rename it and restart before saving sites.", ex);
+        }
+    }
+    public static void Validate(SiteLibrary value)
+    {
+        foreach (var sites in new[] { value.Shortcuts, value.Bookmarks }) {
+            if (sites is null || sites.Length > 100) throw new ArgumentException("Use at most 100 sites per collection.");
+            foreach (var site in sites)
+                if (site is null || string.IsNullOrWhiteSpace(site.Title) || site.Title.Length > 120 || site.Title.Any(char.IsControl)
+                    || site.Url is null || site.Url.Length > 4096 || site.Url.Any(char.IsControl) || !BrowserPolicy.IsWebUrl(site.Url))
+                    throw new ArgumentException("Saved sites require a title and a valid HTTP(S) address without credentials.");
+        }
+    }
+    public void Save(SiteLibrary value)
+    {
+        if (loadFailed) throw new IOException("Repair or rename sites.json and restart before saving.");
+        Validate(value); Directory.CreateDirectory(profileDirectory);
+        var temp = path + "." + Guid.NewGuid().ToString("N") + ".tmp";
+        try {
+            using (var stream = new FileStream(temp, FileMode.CreateNew, FileAccess.Write, FileShare.None)) {
+                JsonSerializer.Serialize(stream, value); stream.Flush(true);
+            }
+            File.Move(temp, path, overwrite: true);
+        }
+        finally { if (File.Exists(temp)) File.Delete(temp); }
+    }
+}
