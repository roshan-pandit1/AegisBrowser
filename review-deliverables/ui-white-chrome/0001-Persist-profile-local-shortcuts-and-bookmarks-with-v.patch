--- /dev/null
+++ b/AegisBrowser.Tests/SiteLibraryTests.cs
@@ -0,0 +1,33 @@
+using AegisBrowser.Core;
+
+internal static class SiteLibraryTests
+{
+    internal static void Run()
+    {
+        var count = 0;
+        void Check(bool value, string name) { if (!value) throw new Exception("FAIL: " + name); count++; }
+        var root = Path.Combine(Path.GetTempPath(), "aegis-sites-" + Guid.NewGuid().ToString("N"));
+        try {
+            var a = new SiteLibraryStore(Path.Combine(root, "a")); var b = new SiteLibraryStore(Path.Combine(root, "b"));
+            Check(a.Load().Shortcuts.Length == 0, "no hardcoded demo shortcuts");
+            var value = new SiteLibrary([new("Unicode café", "https://example.com/a?q=%E6%97%A5")], [new("Docs", "https://example.org/")]);
+            a.Save(value);
+            var restored = new SiteLibraryStore(Path.Combine(root, "a")).Load();
+            Check(restored.Shortcuts.Single() == value.Shortcuts.Single() && restored.Bookmarks.Single() == value.Bookmarks.Single(), "sites persist after reopening");
+            Check(b.Load().Bookmarks.Length == 0, "sites isolated by profile");
+            foreach (var url in new[] { "javascript:alert(1)", "file:///C:/private", "https://name:secret@example.com/" }) {
+                try { a.Save(new([new("Bad", url)], [])); throw new Exception("unsafe site accepted"); }
+                catch (ArgumentException) { count++; }
+            }
+            Check(a.Load().Bookmarks.Single() == value.Bookmarks.Single(), "failed validation preserves saved sites");
+            a.Save(SiteLibrary.Empty); Check(a.Load().Shortcuts.Length == 0 && a.Load().Bookmarks.Length == 0, "site deletion persists");
+            var file = Path.Combine(root, "a", "sites.json"); File.WriteAllText(file, "broken");
+            var broken = new SiteLibraryStore(Path.Combine(root, "a"));
+            try { broken.Load(); throw new Exception("corrupt file accepted"); } catch (IOException) { count++; }
+            try { broken.Save(value); throw new Exception("corrupt file overwritten"); } catch (IOException) { count++; }
+            Check(File.ReadAllText(file) == "broken", "unreadable original preserved");
+        }
+        finally { if (Directory.Exists(root)) Directory.Delete(root, true); }
+        Console.WriteLine($"PASS: {count} saved-site checks");
+    }
+}
