+using AegisBrowser.Core;
+
+namespace AegisBrowser;
+
+internal sealed class SiteLibraryForm : Form
+{
+    internal SiteLibraryForm(string title, SavedSite[] sites, string engine, Action<SavedSite[]> save, Action<string> open)
+    {
+        Text = title; AutoScaleMode = AutoScaleMode.Dpi; Font = new Font("Segoe UI", 10);
+        ClientSize = new(640, 420); MinimumSize = new(440, 300);
+        var list = new ListBox { Dock = DockStyle.Fill, DisplayMember = nameof(SavedSite.Title), AccessibleName = title };
+        void Fill(SavedSite[] value) { list.Items.Clear(); list.Items.AddRange(value); }
+        Fill(sites);
+        var actions = new FlowLayoutPanel { Dock = DockStyle.Bottom, Height = 52, Padding = new Padding(8) };
+        void Button(string text, Action action) {
+            var b = new Button { Text = text, AutoSize = true };
+            b.Click += (_, _) => { try { action(); } catch (Exception ex) when (ex is IOException or UnauthorizedAccessException or ArgumentException) { MessageBox.Show(this, ex.Message, "Saved sites", MessageBoxButtons.OK, MessageBoxIcon.Warning); } };
+            actions.Controls.Add(b);
+        }
+        void Commit(SavedSite[] value) { save(value); Fill(value); }
+        Button("Open", () => { if (list.SelectedItem is SavedSite site) { open(site.Url); Close(); } });
+        Button("Add", () => { if (SiteEditor.Edit(this, null, engine) is { } site) Commit(list.Items.Cast<SavedSite>().Append(site).ToArray()); });
+        Button("Edit", () => { if (list.SelectedItem is SavedSite old && SiteEditor.Edit(this, old, engine) is { } site) Commit(list.Items.Cast<SavedSite>().Select(x => x == old ? site : x).ToArray()); });
+        Button("Remove", () => { if (list.SelectedItem is SavedSite site) Commit(list.Items.Cast<SavedSite>().Where(x => x != site).ToArray()); });
+        list.DoubleClick += (_, _) => { if (list.SelectedItem is SavedSite site) { open(site.Url); Close(); } };
+        Controls.Add(list); Controls.Add(actions); ChromeTheme.Apply(this);
+    }
+}
+
+internal static class SiteEditor
+{
+    internal static SavedSite? Edit(IWin32Window owner, SavedSite? initial, string engine)
+    {
+        using var dialog = new Form { Text = initial is null ? "Add saved site" : "Edit saved site", AutoScaleMode = AutoScaleMode.Dpi,
+            Font = new Font("Segoe UI", 10), ClientSize = new(480, 250), MinimumSize = new(400, 280), StartPosition = FormStartPosition.CenterParent };
+        var body = new TableLayoutPanel { Dock = DockStyle.Fill, Padding = new Padding(20), ColumnCount = 1, RowCount = 5 };
+        var title = new TextBox { Text = initial?.Title ?? "", Dock = DockStyle.Fill, MaxLength = 120, AccessibleName = "Site title" };
+        var url = new TextBox { Text = initial?.Url ?? "", Dock = DockStyle.Fill, MaxLength = 4096, AccessibleName = "Site address or search" };
+        var save = new Button { Text = "Save", AutoSize = true }; SavedSite? result = null;
+        save.Click += (_, _) => {
+            var resolved = AddressInputResolver.Resolve(url.Text, engine);
+            if (resolved.Url is null || !BrowserPolicy.IsWebUrl(resolved.Url) || string.IsNullOrWhiteSpace(title.Text)) {
+                MessageBox.Show(dialog, "Enter a title and an HTTP(S) address or search query."); return;
+            }
+            result = new(title.Text.Trim(), resolved.Url); dialog.DialogResult = DialogResult.OK;
+        };
+        body.Controls.Add(new Label { Text = "Title", AutoSize = true }); body.Controls.Add(title);
+        body.Controls.Add(new Label { Text = "Address or search", AutoSize = true }); body.Controls.Add(url); body.Controls.Add(save);
+        dialog.Controls.Add(body); dialog.AcceptButton = save; ChromeTheme.Apply(dialog);
