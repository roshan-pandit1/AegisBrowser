diff --git a/AegisBrowser/ChromeTheme.cs b/AegisBrowser/ChromeTheme.cs
new file mode 100644
index 0000000..4e6d5a0
--- /dev/null
+++ b/AegisBrowser/ChromeTheme.cs
@@ -0,0 +1,59 @@
+using System.Drawing.Drawing2D;
+
+namespace AegisBrowser;
+
+internal static class ChromeTheme
+{
+    internal static readonly Color Navy = Color.FromArgb(28, 43, 65);
+    internal static readonly Color Blue = Color.FromArgb(42, 102, 206);
+    internal static readonly Color Pale = Color.FromArgb(240, 246, 255);
+    internal static readonly Color Red = Color.FromArgb(203, 55, 67);
+    internal static readonly Color Border = Color.FromArgb(218, 226, 237);
+    internal static void Apply(Control root)
+    {
+        root.BackColor = Color.White; root.ForeColor = Navy;
+        foreach (Control control in root.Controls) {
+            Apply(control);
+            if (control is Button b) {
+                b.FlatStyle = FlatStyle.Flat; b.FlatAppearance.BorderColor = Border;
+                b.FlatAppearance.MouseOverBackColor = Pale; b.FlatAppearance.MouseDownBackColor = Color.FromArgb(220, 234, 255);
+                b.ForeColor = Blue; b.UseVisualStyleBackColor = false;
+                b.Padding = new Padding(4); b.MinimumSize = new Size(32, 32);
+            }
+            if (control is TextBox t) t.BorderStyle = BorderStyle.FixedSingle;
+        }
+    }
+}
+
+internal sealed class ShieldMark : Control
+{
+    internal ShieldMark() { DoubleBuffered = true; AccessibleName = "AegisBrowser shield"; TabStop = false; }
+    protected override void OnPaint(PaintEventArgs e)
+    {
+        base.OnPaint(e); e.Graphics.SmoothingMode = SmoothingMode.AntiAlias;
+        float w = ClientSize.Width, h = ClientSize.Height;
+        using var blue = new SolidBrush(ChromeTheme.Blue); using var red = new SolidBrush(ChromeTheme.Red);
+        e.Graphics.FillPolygon(blue, new PointF[] {new(w*.5f,h*.08f),new(w*.88f,h*.23f),new(w*.82f,h*.65f),new(w*.5f,h*.94f),new(w*.18f,h*.65f),new(w*.12f,h*.23f)});
+        e.Graphics.FillPolygon(red, new PointF[] {new(w*.5f,h*.2f),new(w*.75f,h*.3f),new(w*.7f,h*.59f),new(w*.5f,h*.79f)});
+        using var pen = new Pen(Color.White, Math.Max(2, w*.045f));
+        e.Graphics.DrawLines(pen, new PointF[] {new(w*.3f,h*.51f),new(w*.45f,h*.65f),new(w*.7f,h*.36f)});
+    }
+}
+
+internal sealed class SearchFieldPanel : Panel
+{
+    internal SearchFieldPanel() { DoubleBuffered = true; Padding = new Padding(12); }
+    protected override void OnPaint(PaintEventArgs e)
+    {
+        base.OnPaint(e); e.Graphics.SmoothingMode = SmoothingMode.AntiAlias;
+        var d = Math.Min(20f * DeviceDpi / 96f, Math.Min(Width, Height) - 2f);
+        if (d <= 0) return;
+        using var path = new GraphicsPath();
+        path.AddArc(1, 1, d, d, 180, 90); path.AddArc(Width - d - 2, 1, d, d, 270, 90);
+        path.AddArc(Width - d - 2, Height - d - 2, d, d, 0, 90); path.AddArc(1, Height - d - 2, d, d, 90, 90); path.CloseFigure();
+        using var pen = new Pen(ContainsFocus ? ChromeTheme.Blue : ChromeTheme.Border, ContainsFocus ? 2 : 1);
+        e.Graphics.DrawPath(pen, path);
+    }
+    protected override void OnEnter(EventArgs e) { base.OnEnter(e); Invalidate(); }
+    protected override void OnLeave(EventArgs e) { base.OnLeave(e); Invalidate(); }
+}
diff --git a/AegisBrowser/HomeView.cs b/AegisBrowser/HomeView.cs
new file mode 100644
index 0000000..7ef532f
--- /dev/null
+++ b/AegisBrowser/HomeView.cs
@@ -0,0 +1,47 @@
+using AegisBrowser.Core;
+
+namespace AegisBrowser;
+
+// Native chrome: no remote assets, privileged JS bridge, suggestions or prefetch.
+internal sealed class HomeView : UserControl
+{
+    private readonly Font wordmarkFont = new("Segoe UI", 28, FontStyle.Bold);
+    private readonly TextBox query = new() { Dock = DockStyle.Fill, PlaceholderText = "Search or enter address", AccessibleName = "Homepage search or address" };
+    private readonly FlowLayoutPanel tiles = new() { AutoSize = true, Dock = DockStyle.Top, WrapContents = true };
+    private readonly Label privacy = new() { AutoSize = true, Dock = DockStyle.Top, Padding = new Padding(0, 16, 0, 0) };
+    private readonly Action<string> navigate;
+    private readonly Action add;
+    internal HomeView(Action<string> navigate, Action add)
+    {
+        this.navigate = navigate; this.add = add;
+        Dock = DockStyle.Fill; AutoScroll = true; Padding = new Padding(24, 40, 24, 24);
+        var outer = new TableLayoutPanel { Dock = DockStyle.Top, AutoSize = true, ColumnCount = 3 };
+        outer.ColumnStyles.Add(new(SizeType.Percent, 15)); outer.ColumnStyles.Add(new(SizeType.Percent, 70)); outer.ColumnStyles.Add(new(SizeType.Percent, 15));
+        var body = new TableLayoutPanel { Dock = DockStyle.Top, AutoSize = true, ColumnCount = 1 };
+        body.ColumnStyles.Add(new(SizeType.Percent, 100));
+        body.Controls.Add(new ShieldMark { Size = new(72, 80), Anchor = AnchorStyles.None });
+        body.Controls.Add(new Label { Text = "AegisBrowser", Font = wordmarkFont, AutoSize = true, Anchor = AnchorStyles.None, Margin = new Padding(0, 12, 0, 4) });
+        body.Controls.Add(new Label { Text = "Private • Secure • Fast", AutoSize = true, Anchor = AnchorStyles.None, Margin = new Padding(0, 0, 0, 28) });
+        var search = new TableLayoutPanel { Dock = DockStyle.Top, AutoSize = true, ColumnCount = 2, Padding = new Padding(8) };
+        search.ColumnStyles.Add(new(SizeType.Percent, 100)); search.ColumnStyles.Add(new(SizeType.Absolute, 84));
+        var go = new Button { Text = "Search", Dock = DockStyle.Fill, AccessibleName = "Submit homepage search" };
+        go.Click += (_, _) => navigate(query.Text);
+        query.KeyDown += (_, e) => { if (e.KeyCode == Keys.Enter) { e.SuppressKeyPress = true; navigate(query.Text); } };
+        var field = new SearchFieldPanel { Dock = DockStyle.Fill, Height = 52, MinimumSize = new Size(120, 52) };
+        field.Controls.Add(query); search.Controls.Add(field); search.Controls.Add(go); body.Controls.Add(search);
+        body.Controls.Add(tiles); body.Controls.Add(privacy);
+        outer.Controls.Add(body, 1, 0); Controls.Add(outer); ChromeTheme.Apply(this); query.BorderStyle = BorderStyle.None;
+    }
+    internal void RefreshSites(SavedSite[] sites)
+    {
+        foreach (Control c in tiles.Controls.Cast<Control>().ToArray()) c.Dispose();
+        foreach (var site in sites) {
+            var button = new Button { Text = site.Title, Width = 136, Height = 52, AutoEllipsis = true, AccessibleName = "Open shortcut " + site.Title };
+            button.Click += (_, _) => navigate(site.Url); tiles.Controls.Add(button);
+        }
+        var addButton = new Button { Text = "+ Add shortcut", Width = 136, Height = 52 };
+        addButton.Click += (_, _) => add(); tiles.Controls.Add(addButton); ChromeTheme.Apply(tiles);
+    }
+    protected override void Dispose(bool disposing) { if (disposing) wordmarkFont.Dispose(); base.Dispose(disposing); }
+    internal void SetPrivacy(string text) => privacy.Text = text;
+}
